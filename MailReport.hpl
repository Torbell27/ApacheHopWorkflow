    <name>Read Dashboard</name>
    <sql>SELECT
    metric_name,
    metric_value,
    metric_description,
    calculated_at
FROM public.dashboard_summary
ORDER BY metric_name;</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>Postgres</connection>
    <lookup/>
