      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TableInput</type>
    <name>Read Report Overview</name>
    <sql>SELECT
    (SELECT COUNT(*) FROM public.products_clean) AS total_products,
    (SELECT COUNT(*) FROM public.products_enriched) AS enriched_products,
    (SELECT COUNT(*) FROM public.data_quality_log
     WHERE check_status = 'PASS') AS passed_checks,
    (SELECT COUNT(*) FROM public.data_quality_log
     WHERE check_status = 'FAIL') AS failed_checks,
    (SELECT ROUND(AVG(price), 2)
     FROM public.products_clean) AS average_price_gbp,
    (SELECT ROUND(AVG(price_usd_current), 2)
     FROM public.products_enriched) AS average_price_usd,
    (SELECT MAX(exchange_rate)
     FROM public.fx_rates
     WHERE base_currency = 'GBP'
       AND quote_currency = 'USD') AS gbp_usd_rate;</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>Postgres</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
