  <transform>
    <type>TableInput</type>
    <name>Check Data Quality</name>
    <sql>SELECT
    'missing_product_id' AS check_name,
    COUNT(*) AS failed_count,
    CASE WHEN COUNT(*) = 0 THEN 'PASS' ELSE 'FAIL' END AS check_status
FROM public.products_clean
WHERE product_id IS NULL OR TRIM(product_id) = ''

UNION ALL

SELECT
    'missing_title',
    COUNT(*),
    CASE WHEN COUNT(*) = 0 THEN 'PASS' ELSE 'FAIL' END
FROM public.products_clean
WHERE title IS NULL OR TRIM(title) = ''

UNION ALL

SELECT
    'missing_price',
    COUNT(*),
    CASE WHEN COUNT(*) = 0 THEN 'PASS' ELSE 'FAIL' END
FROM public.products_clean
WHERE price IS NULL

UNION ALL

SELECT
    'negative_price',
    COUNT(*),
    CASE WHEN COUNT(*) = 0 THEN 'PASS' ELSE 'FAIL' END
FROM public.products_clean
WHERE price &lt; 0

UNION ALL

SELECT
    'invalid_rating',
    COUNT(*),
    CASE WHEN COUNT(*) = 0 THEN 'PASS' ELSE 'FAIL' END
FROM public.products_clean
WHERE rating &lt; 1 OR rating > 5

UNION ALL

SELECT
    'missing_collected_at',
    COUNT(*),
    CASE WHEN COUNT(*) = 0 THEN 'PASS' ELSE 'FAIL' END
FROM public.products_clean
WHERE collected_at IS NULL;</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
