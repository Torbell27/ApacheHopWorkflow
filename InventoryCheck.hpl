    <modified_date>2026/10/30 04:30:41.572</modified_date>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Calculate Inventory Metrics</name>
    <sql>SELECT
    CASE
        WHEN in_stock = TRUE THEN 'In Stock'
        WHEN in_stock = FALSE THEN 'Out of Stock'
        ELSE 'Unknown'
    END AS stock_status,

    COUNT(*) AS product_count,

    ROUND(
        COUNT(*) * 100.0 /
        NULLIF((SELECT COUNT(*) FROM public.products_clean), 0),
        2
    ) AS percentage_of_products,

    ROUND(AVG(price), 2) AS average_price

FROM public.products_clean
GROUP BY
    CASE
        WHEN in_stock = TRUE THEN 'In Stock'
        WHEN in_stock = FALSE THEN 'Out of Stock'
        ELSE 'Unknown'
    END
ORDER BY stock_status;</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>Postgres</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>48</xloc>
      <yloc>208</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
