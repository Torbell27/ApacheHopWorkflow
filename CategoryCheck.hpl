  </info>
  <transform>
    <type>TableInput</type>
    <name>Calculate Category Metrics</name>
    <sql>SELECT
    COALESCE(NULLIF(TRIM(category), ''), 'Unknown') AS category,
    COUNT(*) AS product_count,
    ROUND(AVG(price), 2) AS average_price,
    MIN(price) AS min_price,
    MAX(price) AS max_price,
    ROUND(AVG(rating), 2) AS average_rating,
    SUM(COALESCE(review_count, 0)) AS total_reviews
FROM public.products_clean
GROUP BY COALESCE(NULLIF(TRIM(category), ''), 'Unknown')
ORDER BY product_count DESC;</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>Postgres</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>128</xloc>
      <yloc>128</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TableOutput</type>
    <name>Load Category Analytics</name>
    <connection>Postgres</connection>
    <schema/>
    <table>category_analytics</table>
    <commit>1000</commit>
    <truncate>Y</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <specify_fields>N</specify_fields>
    <auto_update_table_structure>N</auto_update_table_structure>
    <always_drop_and_recreate>N</always_drop_and_recreate>
    <add_columns>N</add_columns>
    <drop_columns>N</drop_columns>
    <change_column_types>N</change_column_types>
    <fields>
      <field>
        <stream_name>category</stream_name>
        <column_name>category</column_name>
      </field>
      <field>
        <stream_name>product_count</stream_name>
        <column_name>product_count</column_name>
      </field>
      <field>
        <stream_name>average_price</stream_name>
        <column_name>average_price</column_name>
      </field>
      <field>
