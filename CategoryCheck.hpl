        <column_name>average_rating</column_name>
      </field>
      <field>
        <stream_name>total_reviews</stream_name>
        <column_name>total_reviews</column_name>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>352</xloc>
      <yloc>128</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
